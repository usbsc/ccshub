{
  "name": "ccshub",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "type-check": "tsc --noEmit",
    "update:maxpreps-teams": "node scripts/update-maxpreps-teams.mjs",
    "update:maxpreps-rosters": "node scripts/update-maxpreps-players.mjs",
    "update:maxpreps": "npm run update:maxpreps-teams && npm run update:maxpreps-rosters",
    "sync:maxpreps": "node scripts/sync-maxpreps-all.mjs",
    "sync:maxpreps:dry": "node scripts/sync-maxpreps-all.mjs --dry-run",
    "sync:maxpreps:no-backup": "node scripts/sync-maxpreps-all.mjs --skip-backup"
  },
